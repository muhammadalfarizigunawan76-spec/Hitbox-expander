local HitboxSize = tonumber(sizeBox.Text) or 10  
local HitboxTransparency = tonumber(transBox.Text) or 0.3  
local Disabled = true  
local PlayersList = {}  
  
local function refreshTargets()  
	PlayersList = {}  
	for _, pl in ipairs(Players:GetPlayers()) do  
		if pl ~= player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then  
			table.insert(PlayersList, pl)  
		end  
	end  
end  
  
sizeBox.FocusLost:Connect(function()  
	local n = tonumber(sizeBox.Text)  
	if n then HitboxSize = n else sizeBox.Text = tostring(HitboxSize) end  
end)  
  
transBox.FocusLost:Connect(function()  
	local t = tonumber(transBox.Text)  
	if t and t >= 0 and t <= 1 then HitboxTransparency = t else transBox.Text = tostring(HitboxTransparency) end  
end)  
  
addBtn.MouseButton1Click:Connect(function()  
	local n = tonumber(sizeBox.Text) or 0  
	HitboxSize = HitboxSize + n  
	sizeBox.Text = tostring(HitboxSize)  
end)  
  
subBtn.MouseButton1Click:Connect(function()  
	local n = tonumber(sizeBox.Text) or 0  
	HitboxSize = math.max(1, HitboxSize - n)  
	sizeBox.Text = tostring(HitboxSize)  
end)  
  
toggleBtn.MouseButton1Click:Connect(function()  
	Disabled = not Disabled  
	toggleBtn.Text = Disabled and "Enable Hitbox" or "Disable Hitbox"  
end)  
  
closeBtn.MouseButton1Click:Connect(function()  
	frame.Visible = false  
	miniBtn.Visible = true  
end)  
  
miniBtn.MouseButton1Click:Connect(function()  
	frame.Visible = true  
	miniBtn.Visible = false  
end)  
  
RunService.RenderStepped:Connect(function()  
	if not Disabled then  
		for _, pl in ipairs(PlayersList) do  
			if pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then  
				local part = pl.Character.HumanoidRootPart  
				part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)  
				part.Transparency = HitboxTransparency  
				part.BrickColor = BrickColor.new("White")  
				part.Material = Enum.Material.Plastic -- <-- fix: tidak glowing  
				part.CanCollide = false  
			end  
		end  
	end  
end)  
  
while true do  
	refreshTargets()  
	wait(1)  
end
